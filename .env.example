# Local Postgres in development, Neon's pooled endpoint in production.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/atlas
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/atlas_test

# Playwright e2e run. Defaults to DATABASE_URL with the database name swapped to
# atlas_e2e; the run creates that database and applies migrations on first use.
# E2E_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/atlas_e2e

# Migrations prefer a direct connection. On Vercel, Neon's integration sets
# DATABASE_URL_UNPOOLED for you; set MIGRATE_DATABASE_URL only to override both.
# MIGRATE_DATABASE_URL=

# API port for the local dev server. Vite proxies /api here.
PORT=8787

# Send the session cookie only over HTTPS. Defaults to on in production.
ATLAS_COOKIE_SECURE=false

# Shared secret the Vercel cron request must present to run the session sweep.
CRON_SECRET=
